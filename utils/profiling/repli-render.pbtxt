# Bounded local rendering capture for the release-derived Repli benchmark package.
# Feed through stdin to perfetto --background-wait --txt -c -.
# Run only while the local typing test host is foreground; the ftrace sources
# include system scheduling and frame metadata as well as the selected app scopes.
buffers { size_kb: 32768 fill_policy: RING_BUFFER }
duration_ms: 12000
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "binder/binder_transaction"
      ftrace_events: "binder/binder_transaction_received"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "input"
      atrace_apps: "com.replyai.repli.keyboard.bench"
      atrace_apps: "local.repli.typingprobe"
    }
  }
}
data_sources { config { name: "linux.process_stats" process_stats_config { scan_all_processes_on_start: true } } }
data_sources { config { name: "android.surfaceflinger.frametimeline" } }
